# PostgreSQL connection. docker compose starts a local database on port 5432.
DATABASE_URL="postgresql://domaingate:domaingate_dev_password@localhost:5432/domaingate?schema=public"

# Demo dashboard login. Change both before exposing this application anywhere.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-long-demo-password"

# Use a cryptographically random secret of at least 32 characters.
# Example generation: openssl rand -base64 48
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Displayed as the desired CNAME target in the dashboard. This app does not
# provision DNS, route traffic, or issue certificates by itself.
ROUTING_TARGET="domains.example-hosting-provider.com"

# Optional: a platform-owned base domain you don't want users to claim.
# Example: "links.your-saas.com"
RESERVED_DOMAIN=""
